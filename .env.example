# GS3D rebuild — environment template
# Copy to .env.local and fill in. Live values live only in your Vercel project
# environment + Vercel account; they are NOT shipped inside this bundle.

# Vercel Blob (used by api/upload.js and api/inbox.js)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Admin inbox gate (value of the Vercel project env var ADMIN_PASSWORD,
# sent as the X-Admin-Pass header to api/inbox.js)
ADMIN_PASSWORD=

# Vercel CLI (local deploys only; Vercel injects the rest at runtime)
VERCEL_OIDC_TOKEN=
# VERCEL_TOKEN=            # optional: personal deploy token (vcp_…) — rotate regularly

# Optional: email the owner when a new enquiry is recorded.
# Without RESEND_API_KEY nothing is sent; the enquiry still lands in the inbox.
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=gs3dprinting@gmail.com
ENQUIRY_NOTIFY_FROM=GS3D Website <onboarding@resend.dev>

# Public origin used for /files/ links in WhatsApp drafts (defaults to
# https://gs3dprinting.com when unset).
PUBLIC_BASE_URL=https://gs3dprinting.com
